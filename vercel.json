{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/menu/index.html",
      "destination": "/menu/",
      "permanent": true
    },
    {
      "source": "/rezervasyon/index.html",
      "destination": "/rezervasyon/",
      "permanent": true
    },
    {
      "source": "/zh/reservation/index.html",
      "destination": "/zh/reservation/",
      "permanent": true
    },
    {
      "source": "/ar/reservation/index.html",
      "destination": "/ar/reservation/",
      "permanent": true
    },
    {
      "source": "/ko/reservation/index.html",
      "destination": "/ko/reservation/",
      "permanent": true
    },
    {
      "source": "/ru/reservation/index.html",
      "destination": "/ru/reservation/",
      "permanent": true
    },
    {
      "source": "/en/reservation/index.html",
      "destination": "/en/reservation/",
      "permanent": true
    },
    {
      "source": "/kahvalti/index.html",
      "destination": "/kahvalti/",
      "permanent": true
    },
    {
      "source": "/konum/index.html",
      "destination": "/konum/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/en/menu/index.html",
      "destination": "/en/menu/",
      "permanent": true
    },
    {
      "source": "/en/breakfast/index.html",
      "destination": "/en/breakfast/",
      "permanent": true
    },
    {
      "source": "/en/location/index.html",
      "destination": "/en/location/",
      "permanent": true
    },
    {
      "source": "/kahvalti-rehberi/index.html",
      "destination": "/kahvalti-rehberi/",
      "permanent": true
    },
    {
      "source": "/en/breakfast-guide/index.html",
      "destination": "/en/breakfast-guide/",
      "permanent": true
    },
    {
      "source": "/sik-sorulan-sorular/index.html",
      "destination": "/sik-sorulan-sorular/",
      "permanent": true
    },
    {
      "source": "/en/faq/index.html",
      "destination": "/en/faq/",
      "permanent": true
    },
    {
      "source": "/site-haritasi/index.html",
      "destination": "/site-haritasi/",
      "permanent": true
    },
    {
      "source": "/en/site-map/index.html",
      "destination": "/en/site-map/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pusulalounge.com"
        }
      ],
      "destination": "https://www.pusulalounge.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'sha256-3ELKBN6gv/Ujgqkwc1jR0Gp8I5gyHHuJwnshoizrt3M=' 'sha256-3gRldr92AJrqS9NErmCUeXK2Awuy0SNbCnpgwmbofXQ=' 'sha256-6D4qebjxoY6NMU/dTKOX3r6YcddEIY+1LDkLRNv7AvM=' 'sha256-6bJ8TBjGM6B6egG73T1B/qqQQQJ9GewRL74Giv6GG8E=' 'sha256-7XlZy6gXz+QxWX0L1Ujc/pnhr/+HPhyp04O8qo8F3l4=' 'sha256-8/m3//WcDDedjQfmic0ZIxTpsivQ9JxGLoLvxBU2D+I=' 'sha256-8bve4AEtPZ5gAdJ3wfYPgbNgxA6DUDHrgT3Y+hytzfo=' 'sha256-ALRKodpL11F3thDhQwFPKbdq5CvztNJXfx1KfhJqU3c=' 'sha256-D+hsVtjISsBvyexiQX66nf8p9o78wz+dxch+1sZ0Ly4=' 'sha256-DTaAIEV/R74G0Nf2yFY2x4ZcrexY6YKQmkOFl+41Fxs=' 'sha256-FbTZKE5TI7kg5G5eGwkCGYCqlJ6EpWuHDMM8Ps1M8B8=' 'sha256-G2ZuzuwV/Xs0XRZ71nvOaTjnW/StXNGne7nl7ZlYSr0=' 'sha256-GxbFSjvDFmKssNmzZCvy80MQigZEyfspnzbdtoZOUQ8=' 'sha256-KU/xPP4AkaZ32qbh+dZM66r1sHhWKStryjBmMKJJ+ZI=' 'sha256-LQIqDERPnppN/WzwCzWuiDrs80vw65ZIB2KaRU7VMiU=' 'sha256-PKbihxAE6W6UEcLPTcqiNl78QjnpALLxAZj0S2ETL4Y=' 'sha256-YOo2Nq3Y9G+qLG6pLPw+kTJaRl16YuEDJx/BPzlk/xE=' 'sha256-cJkQqxaP73JjN16fZEqAgMDzt4Shq+PeRQI3FtxZ0r4=' 'sha256-fkjFdeF41WvjRATDN++ZgegT2rPs79vps69WaxFg44k=' 'sha256-h/tFuowZH6aKIZ4eCZijvPqRkUZpbqUn3NLOmeCkoEA=' 'sha256-onED4PNcyyCgSKEGgazssG4ubxOXeWRas7u/uW0IFro=' 'sha256-wU5E7SmLkeUkAaMcXyCLaSlAtOE96UKU0s1Zbsj8Kho=' 'sha256-wgqMkQMiT5COHGY9t7/M7Xm9VI42b//FYQi74T3exiE='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; form-action 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), display-capture=(), serial=(), hid=(), clipboard-write=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:path*.:ext(css|js|woff2|webp|png|avif|jpg|jpeg|svg)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

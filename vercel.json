{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/menu/index.html",
      "destination": "/menu/",
      "permanent": true
    },
    {
      "source": "/rezervasyon/index.html",
      "destination": "/rezervasyon/",
      "permanent": true
    },
    {
      "source": "/kahvalti/index.html",
      "destination": "/kahvalti/",
      "permanent": true
    },
    {
      "source": "/konum/index.html",
      "destination": "/konum/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/en/menu/index.html",
      "destination": "/en/menu/",
      "permanent": true
    },
    {
      "source": "/en/breakfast/index.html",
      "destination": "/en/breakfast/",
      "permanent": true
    },
    {
      "source": "/en/location/index.html",
      "destination": "/en/location/",
      "permanent": true
    },
    {
      "source": "/kahvalti-rehberi/index.html",
      "destination": "/kahvalti-rehberi/",
      "permanent": true
    },
    {
      "source": "/en/breakfast-guide/index.html",
      "destination": "/en/breakfast-guide/",
      "permanent": true
    },
    {
      "source": "/sik-sorulan-sorular/index.html",
      "destination": "/sik-sorulan-sorular/",
      "permanent": true
    },
    {
      "source": "/en/faq/index.html",
      "destination": "/en/faq/",
      "permanent": true
    },
    {
      "source": "/site-haritasi/index.html",
      "destination": "/site-haritasi/",
      "permanent": true
    },
    {
      "source": "/en/site-map/index.html",
      "destination": "/en/site-map/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pusulalounge.com"
        }
      ],
      "destination": "https://www.pusulalounge.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'sha256-26ci1JLTYH3fGDs9M32wIKkzCyIiLlC0eEp0sdOP9mU=' 'sha256-3FNivbacoLtawKIdYJMuvrncTjZXlSWsgfGOatFJeSg=' 'sha256-3gRldr92AJrqS9NErmCUeXK2Awuy0SNbCnpgwmbofXQ=' 'sha256-6D4qebjxoY6NMU/dTKOX3r6YcddEIY+1LDkLRNv7AvM=' 'sha256-7FRuB6OrmG6NyhtixJRiwQw8nFCOjVCphZby3bYfHiM=' 'sha256-Czg1MH/FwJkOx9796V2/U2KvexaN+3cSIQfgziMwnJM=' 'sha256-G2ZuzuwV/Xs0XRZ71nvOaTjnW/StXNGne7nl7ZlYSr0=' 'sha256-N0HoSgp8nM83dKUMGkAPmQs6Ux8A4kvUlKy0eZqGTmE=' 'sha256-Qy3H6dfOzM9cuwZgVn8fyDM0iN+o6+RGPtphH0nZ2FQ=' 'sha256-VbnkLoW3KsS5HTaLmJx6Dk2QcJMG9RopUOU8NGTw3mY=' 'sha256-X+K9uV0G3Gi7vSW3RYhy0AhK259GlaWq2gUN52kEnZ8=' 'sha256-XOnp0jsPjez2rKdWURtHSo6ln9gYYOFKsgYv6QDdLWA=' 'sha256-XQTq/kn4ed8B/61dVpETmlkveKuUPE61c9hNGJbORC4=' 'sha256-aCmJQ/xLqrwVl8eMYEZYvwpW03kXALaRzq9tQMMrQTI=' 'sha256-eHIOlhsspLRlQXmACgMzpIr8tXaCAW6sMmxt7yLvrPM=' 'sha256-eXeVC+uQ9tVcjxX246nnhtvSOSgXj8XgvnpBTwF/+u4=' 'sha256-tSULMPzyvEtHdiMM3z0niS582gIioPg98dBh89x8g78=' 'sha256-u/HTnlKH+NjV4xUQBuut6hUPtzqzqqauzSlCIWaHdrU=' 'sha256-wgqMkQMiT5COHGY9t7/M7Xm9VI42b//FYQi74T3exiE=' 'sha256-xaQJHc6N2OX9r+8loRa57TCRYKNly5Ia4L3dbkhKPDY=' 'sha256-ySs4HCXOuV8FBXJoJWMDxO96qqTf6zsjiAfmUDDFWB0='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; form-action 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:path*.:ext(css|js|woff2|webp|png|avif|jpg|jpeg|svg)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
